<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TrueFluentPro</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <TieredPGO>true</TieredPGO>
    <!-- app.manifest 仅在 Windows 构建时生效（macOS/Linux 发布时自动跳过） -->
    <ApplicationManifest Condition="!$(RuntimeIdentifier.StartsWith('osx')) AND !$(RuntimeIdentifier.StartsWith('linux'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <AppIconPng>Assets\AppIcon.png</AppIconPng>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- macOS 构建时添加条件编译符号 -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <DefineConstants>$(DefineConstants);MACOS_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- ═══ 跨平台依赖（所有平台共享） ═══ -->
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.4.0" />
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="PuppeteerSharp" Version="24.40.0" />
    <!-- 修复 CVE-2026-39959: Tmds.DBus.Protocol 0.21.2 高危漏洞，提升传递依赖到已修复版本 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.0" />
    <PackageReference Include="Markdig" Version="1.1.1" />
    
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.48.2" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech.Extension.MAS" Version="1.48.2" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.22.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" Version="9.6.2" />
    <PackageReference Include="ReverseMarkdown" Version="5.2.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SmartReader" Version="0.11.0" />
    <PackageReference Include="SoundFlow.Extensions.WebRtc.Apm" Version="1.4.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.9.2" />
  </ItemGroup>

  <!-- ═══ Windows 专属依赖（macOS/Linux 发布时自动排除，日常 Windows 开发不受影响） ═══ -->
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('osx')) AND !$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="backend\**\*.cs" />
    <AvaloniaXaml Remove="tools\**\*.axaml" />
    <AvaloniaResource Remove="tools\**\*.axaml" />
    <None Include="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Assets\billing-tiers.json" LogicalName="TrueFluentPro.Assets.billing-tiers.json" />
    <EmbeddedResource Include="Assets\image-models.json" LogicalName="TrueFluentPro.Assets.image-models.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\RELEASE_NOTES.md" Link="RELEASE_NOTES.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\RELEASE_NOTES.md')" />
    <None Include="RELEASE_NOTES.md" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('Assets\RELEASE_NOTES.md') and Exists('RELEASE_NOTES.md')" />
    <None Update="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 构建后自动编译 Updater 并拷贝到输出目录（仅 Windows，macOS/Linux 构建时跳过） -->
  <Target Name="BuildAndCopyUpdater" AfterTargets="Build" Condition="!$(RuntimeIdentifier.StartsWith('osx')) AND !$(RuntimeIdentifier.StartsWith('linux'))">
    <Exec Command="dotnet build &quot;$(ProjectDir)tools\Updater\Updater.csproj&quot; -c $(Configuration) -v q --nologo" />
    <ItemGroup>
      <UpdaterFiles Include="$(ProjectDir)tools\Updater\bin\$(Configuration)\net10.0\Updater.exe" Condition="Exists('$(ProjectDir)tools\Updater\bin\$(Configuration)\net10.0\Updater.exe')" />
      <UpdaterFiles Include="$(ProjectDir)tools\Updater\bin\$(Configuration)\net10.0\Updater.dll" Condition="Exists('$(ProjectDir)tools\Updater\bin\$(Configuration)\net10.0\Updater.dll')" />
      <UpdaterFiles Include="$(ProjectDir)tools\Updater\bin\$(Configuration)\net10.0\Updater.runtimeconfig.json" Condition="Exists('$(ProjectDir)tools\Updater\bin\$(Configuration)\net10.0\Updater.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- 原生输入法仅编译/交付，不在构建过程中注册到系统。 -->
  <Target Name="BuildVoiceIme" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND !$(RuntimeIdentifier.StartsWith('osx')) AND !$(RuntimeIdentifier.StartsWith('linux')) AND '$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(ProjectDir)tools\VoiceImeNative\Build.ps1&quot; -OutputDirectory &quot;$(TargetDir)voice-ime&quot; -Configuration $(Configuration)" />
    <!-- 静态链接 LGPL：随组件交付对应源码、许可与完整原生重链接入口。 -->
    <ItemGroup>
      <VoiceImeRelinkSources Include="$(ProjectDir)tools\VoiceImeNative\**\*.cpp;$(ProjectDir)tools\VoiceImeNative\**\*.h;$(ProjectDir)tools\VoiceImeNative\**\*.def;$(ProjectDir)tools\VoiceImeNative\**\*.rc;$(ProjectDir)tools\VoiceImeNative\**\*.ico;$(ProjectDir)tools\VoiceImeNative\**\Build.ps1;$(ProjectDir)tools\VoiceImeNative\**\LICENSE.txt;$(ProjectDir)tools\VoiceImeNative\**\TRUEFLUENT-NOTICE.md;$(ProjectDir)tools\VoiceImeNative\**\README.md"
                            Exclude="$(ProjectDir)tools\VoiceImeNative\artifacts\**;$(ProjectDir)tools\VoiceImeNative\ThirdParty\libIME2\lib\**;$(ProjectDir)tools\VoiceImeNative\ThirdParty\libIME2\test\**" />
    </ItemGroup>
    <Copy SourceFiles="@(VoiceImeRelinkSources)" DestinationFiles="@(VoiceImeRelinkSources->'$(TargetDir)voice-ime\source\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)LICENSE" DestinationFiles="$(TargetDir)voice-ime\source\LICENSE" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishVoiceIme" AfterTargets="Publish"
          Condition="'$(OS)' == 'Windows_NT' AND !$(RuntimeIdentifier.StartsWith('osx')) AND !$(RuntimeIdentifier.StartsWith('linux'))">
    <ItemGroup>
      <VoiceImeFiles Include="$(TargetDir)voice-ime\**\TrueFluentVoiceIme.dll;$(TargetDir)voice-ime\**\VoiceImeRegister.exe" />
      <VoiceImePublishedSources Include="$(TargetDir)voice-ime\source\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(VoiceImeFiles)" DestinationFiles="@(VoiceImeFiles->'$(PublishDir)voice-ime\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(VoiceImePublishedSources)" DestinationFiles="@(VoiceImePublishedSources->'$(PublishDir)voice-ime\source\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
