<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueFluentPro.ViewModels.Settings"
             xmlns:models="using:TrueFluentPro.Models"
             xmlns:controls="clr-namespace:TrueFluentPro.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:icons="https://github.com/projektanker/icons.avalonia"
             x:Name="Root"
             x:Class="TrueFluentPro.Views.Settings.EndpointsSection"
             x:DataType="vm:EndpointsSectionVM"
             x:CompileBindings="False">
        <Border Classes="app-card"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="20">
        <Border.Styles>
            <Style Selector="Border.endpoint-disabled-card">
                <Setter Property="Background" Value="#07A1A1AA"/>
                <Setter Property="BorderBrush" Value="#80A1A1AA"/>
            </Style>
            <Style Selector="TextBlock.endpoint-disabled-text">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </Style>
            <Style Selector="Border.endpoint-disabled-panel">
                <Setter Property="Background" Value="#06A1A1AA"/>
                <Setter Property="BorderBrush" Value="#80A1A1AA"/>
            </Style>
            <!-- 超链接：纯文字 + 下划线，悬停加深 -->
            <Style Selector="TextBlock.hyperlink">
                <Setter Property="Foreground" Value="#2563EB"/>
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="TextBlock.hyperlink:pointerover">
                <Setter Property="Foreground" Value="#1D4ED8"/>
            </Style>
            <!-- 子标题旁的信息浮窗图标 -->
            <Style Selector="icons|Icon.info-hint">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Cursor" Value="Help"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2,0,0,0"/>
            </Style>
            <Style Selector="icons|Icon.info-hint:pointerover">
                <Setter Property="Foreground" Value="#2563EB"/>
            </Style>
            <!-- 凭据行标签：纯文字，悬停显示提示 -->
            <Style Selector="TextBlock.cred-label">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Help"/>
            </Style>
            <Style Selector="TextBlock.cred-label:pointerover">
                <Setter Property="Foreground" Value="#2563EB"/>
            </Style>
        </Border.Styles>
        <StackPanel Spacing="12">
            <TextBlock Text="AI 终结点管理" Theme="{StaticResource SubtitleTextBlockStyle}"/>
            <Separator/>
            <TextBlock Text="统一管理 AI 服务终结点与模型注册" Classes="section-description"/>

            <Grid ColumnDefinitions="172,*" ColumnSpacing="12" MinHeight="340">
                <!-- 终结点列表 -->
                <Border Grid.Column="0" Classes="sub-card" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="320">
                    <Grid RowDefinitions="*,Auto">
                        <Grid Grid.Row="0">
                            <ListBox x:Name="EndpointsListBox"
                                     ItemsSource="{Binding Endpoints}"
                                     SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}"
                                     SelectionMode="Single"
                                     PointerReleased="EndpointsListBox_PointerReleased">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:AiEndpoint">
                                        <Border Margin="4" Padding="8" CornerRadius="6"
                                                Classes.endpoint-disabled-card="{Binding !IsEnabled}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Border Width="32" Height="32">
                                                    <svg:Svg Path="{Binding EndpointTypeIconAssetPath}"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"
                                                               Classes.endpoint-disabled-text="{Binding !IsEnabled}"/>
                                                    <TextBlock Text="已停用"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               IsVisible="{Binding !IsEnabled}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Background="#08FFFFFF" IsHitTestVisible="False"
                                    IsVisible="{Binding !HasEndpoints}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="16">
                                    <TextBlock Text="还没有 AI 终结点" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="点左下角“添加”，先建一个可编辑的终结点。"
                                               Classes="field-note" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button Grid.Row="1"
                            Margin="8"
                            Padding="0,10"
                            FontSize="13"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch"
                            Click="CreateEndpoint_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <icons:Icon Value="fa-solid fa-plus" FontSize="12"/>
                                <TextBlock Text="添加" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 终结点详情 -->
                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Left"
                            Opacity="{Binding SelectedEndpointOpacity}"
                            IsVisible="{Binding SelectedEndpoint, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Classes="sub-card"
                            BorderBrush="{DynamicResource SubCardBorderBrush}"
                            Classes.endpoint-disabled-panel="{Binding !SelectedEndpoint.IsEnabled}"
                            BorderThickness="1" CornerRadius="8" Padding="12" MaxWidth="520">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="36" Height="36">
                                    <svg:Svg Path="{Binding SelectedEndpoint.EndpointTypeIconAssetPath}"
                                             Stretch="Uniform"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEndpoint.EndpointTypeDisplayName}" FontWeight="Bold"
                                               ToolTip.Tip="右键左侧列表可编辑分类或删除终结点"/>
                                    <TextBlock Text="当前终结点已停用" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding !SelectedEndpoint.IsEnabled}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2"
                                          Margin="8,0,0,0"
                                          Content="启用"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding SelectedEndpoint.IsEnabled, Mode=TwoWay}"/>
                                <Button Grid.Column="3"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        VerticalContentAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        Click="ShowEndpointInfo_Click"
                                        ToolTip.Tip="点击查看：文字 / 图片 / 视频 / 语音转写 / 文字转语音各能力的认证方式、接口路线与拼装后的 URL 示例">
                                    <icons:Icon Value="fa-solid fa-circle-info" FontSize="15"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="5">
                        <TextBlock Text="终结点名称"/>
                        <TextBox Text="{Binding SelectedEndpoint.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="例如: t99e"
                                 Width="420"
                                 MaxWidth="420"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ═══ 语音服务厂商选择（微软 / 讯飞 / 百度共用）═══ -->
                    <StackPanel Spacing="5" IsVisible="{Binding IsSelectedEndpointAnySpeech}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="语音厂商" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <icons:Icon Value="fa-solid fa-circle-info" FontSize="12" Classes="info-hint">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="320"
                                               Text="选择该终结点使用的语音厂商，切换后下方凭据字段会随之变化。各厂商凭据独立保存，互不影响。"/>
                                </ToolTip.Tip>
                            </icons:Icon>
                        </StackPanel>
                        <ComboBox ItemsSource="{x:Static vm:EndpointsSectionVM.SpeechVendorOptions}"
                                  SelectedValue="{Binding SelectedSpeechVendor, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  Width="420" MaxWidth="420" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ═══ Azure Speech 专属面板 ═══ -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsSelectedEndpointSpeech}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="订阅凭据" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <icons:Icon Value="fa-solid fa-circle-info" FontSize="12" Classes="info-hint">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="320"
                                               Text="{Binding SelectedEndpoint.AsrCredentialHint}"/>
                                </ToolTip.Tip>
                            </icons:Icon>
                        </StackPanel>
                        <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                            <TextBlock Grid.Column="0" Text="Speech 终结点" Classes="cred-label">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                               Text="{Binding SelectedEndpoint.SpeechRegionHint}"/>
                                </ToolTip.Tip>
                            </TextBlock>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedEndpoint.SpeechEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="例如: https://eastasia.api.cognitive.microsoft.com"/>
                            <Panel Grid.Column="2" Width="36"/>
                        </Grid>
                        <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                            <TextBlock Grid.Column="0" Text="订阅密钥" Classes="cred-label">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                               Text="Azure 语音服务订阅密钥，在 Azure 门户「语音服务」资源 →「密钥和终结点」页获取，必填。"/>
                                </ToolTip.Tip>
                            </TextBlock>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedEndpoint.SpeechSubscriptionKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Azure Speech 订阅密钥"
                                     PasswordChar="*"/>
                            <Button Grid.Column="2" Width="36" Height="32"
                                    ToolTip.Tip="复制密钥"
                                    Tag="{Binding SelectedEndpoint.SpeechSubscriptionKey}"
                                    Click="CopyText_Click">
                                <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Padding="8,4" FontSize="11"
                                    Command="{Binding TestSpeechCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:Icon Value="fa-solid fa-flask-vial" FontSize="11"/>
                                    <TextBlock Text="测试连接" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Classes="field-note" Text="{Binding SpeechTestResult}" TextWrapping="Wrap"
                                   IsVisible="{Binding SpeechTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <!-- ═══ 讯飞 / 百度实时语音专属面板 ═══ -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsSelectedEndpointThirdPartyRealtime}">

                        <!-- ── 识别（ASR）凭据：每个厂商独立一块 ── -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="识别凭据（实时语音转写）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <icons:Icon Value="fa-solid fa-circle-info" FontSize="12" Classes="info-hint">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="340" Spacing="4">
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Text="{Binding SelectedEndpoint.EndpointTypeSubtitle}"/>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{Binding SelectedEndpoint.AsrCredentialHint}"/>
                                    </StackPanel>
                                </ToolTip.Tip>
                            </icons:Icon>
                        </StackPanel>

                        <!-- 讯飞识别 -->
                        <StackPanel Spacing="6" IsVisible="{Binding SelectedEndpoint.IsXunfeiRtasrEndpoint}">
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="AppId" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="讯飞开放平台语音应用的 AppId，在控制台「我的应用」中查看，必填。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.XunfeiAsrAppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="讯飞语音应用 AppId"/>
                                <Panel Grid.Column="2" Width="36"/>
                            </Grid>
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="ApiKey" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="讯飞实时语音转写（RTASR）的 ApiKey，用于鉴权，必填。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.XunfeiAsrApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="讯飞 RTASR ApiKey"
                                         PasswordChar="*"/>
                                <Button Grid.Column="2" Width="36" Height="32"
                                        ToolTip.Tip="复制密钥"
                                        Tag="{Binding SelectedEndpoint.XunfeiAsrApiKey}"
                                        Click="CopyText_Click">
                                    <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="ApiSecret" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="可选：部分服务类型需要的 ApiSecret；若你的服务无需则可留空。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.XunfeiAsrApiSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="部分服务需要，可留空"
                                         PasswordChar="*"/>
                                <Button Grid.Column="2" Width="36" Height="32"
                                        ToolTip.Tip="复制密钥"
                                        Tag="{Binding SelectedEndpoint.XunfeiAsrApiSecret}"
                                        Click="CopyText_Click">
                                    <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 百度识别 -->
                        <StackPanel Spacing="6" IsVisible="{Binding SelectedEndpoint.IsBaiduRealtimeAsrEndpoint}">
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="AppId" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="百度语音应用的 AppId（纯数字），在百度智能云「语音技术 → 应用列表」创建应用后获得，必填。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.BaiduAsrAppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="百度语音应用 AppId（数字）"/>
                                <Panel Grid.Column="2" Width="36"/>
                            </Grid>
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="API Key" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="识别用 API Key（AppKey），与 AppId 在同一应用详情页获取，必填。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.BaiduAsrApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="百度实时语音 AppKey"
                                         PasswordChar="*"/>
                                <Button Grid.Column="2" Width="36" Height="32"
                                        ToolTip.Tip="复制密钥"
                                        Tag="{Binding SelectedEndpoint.BaiduAsrApiKey}"
                                        Click="CopyText_Click">
                                    <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- ── 机器翻译（MT）凭据：每个厂商独立一块 ── -->
                        <Separator Margin="0,10,0,4"/>
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,6,0,0">
                            <TextBlock Text="机器翻译凭据（可选）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <icons:Icon Value="fa-solid fa-circle-info" FontSize="12" Classes="info-hint">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="320"
                                               Text="{Binding SelectedEndpoint.MtCredentialHint}"/>
                                </ToolTip.Tip>
                            </icons:Icon>
                        </StackPanel>
                        <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                            <TextBlock Grid.Column="0" Text="翻译厂商" Classes="cred-label">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                               Text="选择实时字幕的机器翻译厂商；选「不翻译」则仅显示识别原文。"/>
                                </ToolTip.Tip>
                            </TextBlock>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Static vm:EndpointsSectionVM.TranslateVendorOptions}"
                                      SelectedValue="{Binding SelectedEndpoint.TranslateVendor, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Value}"
                                      HorizontalAlignment="Stretch"/>
                            <Panel Grid.Column="2" Width="36"/>
                        </Grid>

                        <!-- 讯飞翻译（NiuTrans） -->
                        <StackPanel Spacing="6" IsVisible="{Binding SelectedEndpoint.IsTranslateXunfei}">
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="翻译 AppId" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="讯飞 NiuTrans 机器翻译 AppId；留空则复用上方识别 AppId。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.XunfeiMtAppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="留空则复用识别 AppId"/>
                                <Panel Grid.Column="2" Width="36"/>
                            </Grid>
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="翻译 ApiKey" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="NiuTrans 翻译 ApiKey，启用讯飞翻译时必填。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.XunfeiMtApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="NiuTrans ApiKey"
                                         PasswordChar="*"/>
                                <Button Grid.Column="2" Width="36" Height="32"
                                        ToolTip.Tip="复制密钥"
                                        Tag="{Binding SelectedEndpoint.XunfeiMtApiKey}"
                                        Click="CopyText_Click">
                                    <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="翻译 ApiSecret" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="NiuTrans 翻译 ApiSecret，启用讯飞翻译时必填。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.XunfeiMtApiSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="NiuTrans ApiSecret"
                                         PasswordChar="*"/>
                                <Button Grid.Column="2" Width="36" Height="32"
                                        ToolTip.Tip="复制密钥"
                                        Tag="{Binding SelectedEndpoint.XunfeiMtApiSecret}"
                                        Click="CopyText_Click">
                                    <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 百度翻译 -->
                        <StackPanel Spacing="6" IsVisible="{Binding SelectedEndpoint.IsTranslateBaidu}">
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="翻译 AppId" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="百度翻译开放平台 AppId；留空则复用上方识别 AppId。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.BaiduMtAppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="留空则复用识别 AppId"/>
                                <Panel Grid.Column="2" Width="36"/>
                            </Grid>
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="翻译 ApiKey" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="百度大模型翻译 ApiKey（优先使用）。与下方 SecretKey 二选一即可，无需都填。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.BaiduMtApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="大模型翻译 ApiKey（优先）"
                                         PasswordChar="*"/>
                                <Button Grid.Column="2" Width="36" Height="32"
                                        ToolTip.Tip="复制密钥"
                                        Tag="{Binding SelectedEndpoint.BaiduMtApiKey}"
                                        Click="CopyText_Click">
                                    <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="110,360,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0" Text="翻译 SecretKey" Classes="cred-label">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="300"
                                                   Text="百度通用翻译 SecretKey（回退方案）。若已填大模型 ApiKey 可留空。"/>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedEndpoint.BaiduMtSecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="通用翻译 SecretKey（回退）"
                                         PasswordChar="*"/>
                                <Button Grid.Column="2" Width="36" Height="32"
                                        ToolTip.Tip="复制密钥"
                                        Tag="{Binding SelectedEndpoint.BaiduMtSecretKey}"
                                        Click="CopyText_Click">
                                    <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding SelectedEndpoint.IsXunfeiRtasrEndpoint}">
                            <Button Padding="10,5"
                                    Tag="https://console.xfyun.cn/services/rta"
                                    Click="OpenUrl_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:Icon Value="fa-solid fa-microphone" FontSize="14"/>
                                    <TextBlock Text="讯飞开放平台（语音转写）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="10,5"
                                    Tag="https://www.xfyun.cn/services/niutrans"
                                    Click="OpenUrl_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:Icon Value="fa-solid fa-language" FontSize="14"/>
                                    <TextBlock Text="讯飞机器翻译（NiuTrans）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding SelectedEndpoint.IsBaiduRealtimeAsrEndpoint}">
                            <Button Padding="10,5"
                                    Tag="https://console.bce.baidu.com/ai/#/ai/speech/app/list"
                                    Click="OpenUrl_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:Icon Value="fa-solid fa-microphone" FontSize="14"/>
                                    <TextBlock Text="百度智能云（识别）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="10,5"
                                    Tag="https://fanyi-api.baidu.com/"
                                    Click="OpenUrl_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:Icon Value="fa-solid fa-language" FontSize="14"/>
                                    <TextBlock Text="百度翻译开放平台（翻译）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    <!-- ═══ AI 终结点面板（非 Speech / 非第三方实时语音） ═══ -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsSelectedEndpointAiGeneric}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="API 地址"/>
                        <TextBox Text="{Binding SelectedEndpoint.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="例如: https://api.openai.com"
                                 Width="420"
                                 MaxWidth="420"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="API 版本（可选）"
                                   ToolTip.Tip="{Binding SelectedEndpointApiVersionNote}"/>
                        <TextBox Text="{Binding SelectedEndpoint.ApiVersion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Watermark="{Binding SelectedEndpointApiVersionWatermark}"
                                 Width="420"
                                 MaxWidth="420"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="5" IsVisible="{Binding CanSelectedEndpointUseAad}">
                        <TextBlock Text="认证方式"/>
                        <ComboBox Width="420"
                                  MaxWidth="420"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="{Binding SelectedEndpointAuthMode, Mode=TwoWay}">
                            <ComboBoxItem Content="API Key (默认)"/>
                            <ComboBoxItem Content="Microsoft Entra ID (AAD)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding !IsSelectedEndpointAad}">
                        <TextBlock Text="API 密钥"/>
                        <Grid ColumnDefinitions="420,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                            <TextBox Grid.Column="0"
                                     Text="{Binding SelectedEndpoint.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="sk-..."
                                     PasswordChar="*"
                                     MaxWidth="420"/>
                            <Button Grid.Column="1"
                                    Width="36"
                                    Height="32"
                                    ToolTip.Tip="复制密钥"
                                    Click="CopyApiKey_Click">
                                <icons:Icon Value="fa-regular fa-copy" FontSize="13"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding IsSelectedEndpointAad}">
                        <TextBlock Text="Tenant ID"/>
                        <TextBox Text="{Binding SelectedEndpoint.AzureTenantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Azure AD Tenant ID"
                                 Width="420"
                                 MaxWidth="420"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Text="Client ID（可选）"/>
                        <TextBox Text="{Binding SelectedEndpoint.AzureClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Azure AD Client ID；留空时使用默认公共客户端"
                                 Width="420"
                                 MaxWidth="420"
                                 HorizontalAlignment="Left"/>
                        <controls:AadLoginPanel x:Name="EndpointAadLoginPanel"
                                                  Margin="0,4,0,0"
                                                  HideTenantClientFields="True"/>
                    </StackPanel>

                    <Separator Margin="0,6,0,6"/>
                    <TextBlock Text="模型列表" FontWeight="Bold"
                               ToolTip.Tip="点击模型条目展开编辑；新建后会直接展开并把光标放到模型 ID"/>
                    <ItemsControl ItemsSource="{Binding SelectedEndpointModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:AiModelEntry">
                                <Border Name="ModelItemRoot" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="4"
                                        Margin="0,2" Tag="{Binding}">
                                    <StackPanel>
                                        <!-- 折叠头部：点击展开/收缩 -->
                                        <Border Name="ModelHeaderBorder" Padding="8,6" Cursor="Hand"
                                                PointerPressed="ModelHeader_PointerPressed"
                                                Tag="{Binding}"
                                                Background="Transparent">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <icons:Icon Grid.Column="0" Name="ModelCapIcon" FontSize="12"
                                                            Value="fa-solid fa-caret-right"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="11" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Padding="4,2" FontSize="10"
                                                        VerticalAlignment="Center"
                                                        Click="RemoveModel_Click" Tag="{Binding}"
                                                        ToolTip.Tip="删除模型">
                                                    <icons:Icon Value="fa-solid fa-xmark" FontSize="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <!-- 展开内容：默认隐藏 -->
                                        <StackPanel Name="ModelDetailPanel" IsVisible="False"
                                                    Spacing="4" Margin="8,0,8,6">
                                            <Grid ColumnDefinitions="80,*" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0" Text="模型 ID:" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Name="ModelIdTextBox" Grid.Column="1"
                                                         Text="{Binding ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Watermark="例如：gpt-4o-mini、gpt-image-1、sora-2" FontSize="11" Padding="4,2"/>
                                            </Grid>
                                                                                        <Grid ColumnDefinitions="120,*" ColumnSpacing="6"
                                                  IsVisible="{Binding #Root.DataContext.IsSelectedEndpointAzure}">
                                                                                                <TextBlock Grid.Column="0" Text="Azure 部署名:" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding DeploymentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                 Watermark="旧配置里的“模型名称”；留空默认用模型 ID" FontSize="11" Padding="4,2"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="80,*" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0" Text="能力:" FontSize="11" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                            Name="CapTogglePanel"
                                                            Tag="{Binding}"
                                                            Loaded="CapTogglePanel_Loaded">
                                                    <ToggleButton Classes="cap-toggle cap-text"
                                                                  Tag="Text"
                                                                  ToolTip.Tip="文字对话：洞察、复盘、快问、会话"
                                                                  Checked="CapToggle_Checked" Unchecked="CapToggle_Unchecked">
                                                        <icons:Icon Value="fa-solid fa-font" FontSize="13" Foreground="#8AADA0"/>
                                                    </ToggleButton>
                                                    <ToggleButton Classes="cap-toggle cap-image"
                                                                  Tag="Image"
                                                                  ToolTip.Tip="图片生成：AI 绘图、图片编辑"
                                                                  Checked="CapToggle_Checked" Unchecked="CapToggle_Unchecked">
                                                        <icons:Icon Value="fa-solid fa-image" FontSize="13" Foreground="#B09AAC"/>
                                                    </ToggleButton>
                                                    <ToggleButton Classes="cap-toggle cap-video"
                                                                  Tag="Video"
                                                                  ToolTip.Tip="视频生成：AI 视频创作"
                                                                  Checked="CapToggle_Checked" Unchecked="CapToggle_Unchecked">
                                                        <icons:Icon Value="fa-solid fa-video" FontSize="13" Foreground="#8FA4B8"/>
                                                    </ToggleButton>
                                                    <ToggleButton Classes="cap-toggle cap-stt"
                                                                  Tag="SpeechToText"
                                                                  ToolTip.Tip="语音转文字：音频转写、实时听写"
                                                                  Checked="CapToggle_Checked" Unchecked="CapToggle_Unchecked">
                                                        <icons:Icon Value="fa-solid fa-microphone" FontSize="13" Foreground="#B5A88A"/>
                                                    </ToggleButton>
                                                    <ToggleButton Classes="cap-toggle cap-tts"
                                                                  Tag="TextToSpeech"
                                                                  ToolTip.Tip="文字转语音：语音合成、朗读"
                                                                  Checked="CapToggle_Checked" Unchecked="CapToggle_Unchecked">
                                                        <icons:Icon Value="fa-solid fa-volume-high" FontSize="13" Foreground="#9A92AD"/>
                                                    </ToggleButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Padding="8,4" FontSize="11"
                                Click="AddModel_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:Icon Value="fa-solid fa-plus" FontSize="11"/>
                                <TextBlock Text="添加空模型" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" FontSize="11"
                                Command="{Binding DiscoverModelsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:Icon Value="fa-solid fa-arrows-rotate" FontSize="11"/>
                                <TextBlock Text="从终结点拉取模型" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="field-note" Text="{Binding EndpointDiscoveryStatus}" TextWrapping="Wrap"
                               IsVisible="{Binding EndpointDiscoveryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <ItemsControl ItemsSource="{Binding DiscoveredModelIds}" IsVisible="{Binding HasDiscoveredModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="x:String">
                                <Border Classes="sub-card" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="8,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding .}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Padding="8,2" Tag="{Binding .}"
                                                Click="AddDiscoveredModel_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icons:Icon Value="fa-solid fa-plus" FontSize="10"/>
                                                <TextBlock Text="添加" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel><!-- end AI panel -->
                </StackPanel>

                <Border Grid.Column="1" Classes="sub-card" CornerRadius="8" BorderBrush="{DynamicResource SubCardBorderBrush}"
                        BorderThickness="1" Padding="24" IsVisible="{Binding ShowEmptyState}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="12">
                        <TextBlock Text="先创建一个 AI 终结点" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="先选终结点 API 类型，再填写地址与密钥；高级路由默认已按模板注入。"
                                   Foreground="{DynamicResource TextSubtleBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                        <Button Padding="12,6" Click="CreateEndpoint_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <icons:Icon Value="fa-solid fa-plus" FontSize="12"/>
                                <TextBlock Text="创建第一个终结点" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
