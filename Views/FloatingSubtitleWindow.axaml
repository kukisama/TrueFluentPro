<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TrueFluentPro.ViewModels"
    xmlns:icons="using:Projektanker.Icons.Avalonia"
    x:Class="TrueFluentPro.Views.FloatingSubtitleWindow"
    x:DataType="vm:FloatingSubtitleViewModel" Title="浮动字幕"
    Width="1000"
    Height="160"
    MinWidth="320"
    MaxWidth="2400"
    MinHeight="120"
    MaxHeight="600"
    SystemDecorations="None"
    WindowStartupLocation="Manual"
    Topmost="True"
    CanResize="True"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 字幕主容器 -->
        <Style Selector="Border#MainBorder">
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>

        <!-- 悬浮工具条：默认隐藏，鼠标进入字幕才淡入 -->
        <Style Selector="Border#HoverToolbar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#MainBorder:pointerover Border#HoverToolbar">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border#MainBorder:focus-within Border#HoverToolbar">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!-- 右下角 resize 把手：默认隐藏，hover 时显形 -->
        <Style Selector="Border#ResizeGrip">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#MainBorder:pointerover Border#ResizeGrip">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- 来源彩色小点 -->
        <Style Selector="Ellipse.source-dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 来源说话人图标（喇叭/麦克风/字幕） -->
        <Style Selector="icons|Icon.source-icon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 工具条小按钮 -->
        <Style Selector="Button.toolbar-btn">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolbar-btn:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="Button.toolbar-btn:pressed">
            <Setter Property="Background" Value="#88FFFFFF" />
        </Style>
        <Style Selector="Button.toolbar-btn icons|Icon">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Border Name="MainBorder"
        Background="{Binding BackgroundBrush}"
        CornerRadius="18"
        BorderThickness="0"
        Margin="10"
        BoxShadow="0 8 28 0 #66000000, 0 2 6 0 #44000000"
        PointerPressed="OnSurfacePointerPressed">

        <Grid RowDefinitions="Auto,*">
            <!-- 控制区独立占位，显隐不改变字幕尺寸，也不覆盖正在阅读的文字。 -->
            <Grid Grid.Row="0" Name="CaptionHeader" Height="28" MaxHeight="28"
                  ColumnDefinitions="*,Auto" Margin="12,0,8,0"
                  ToolTip.Tip="拖动移动字幕；Alt+方向键移动，Ctrl+Alt+方向键调整大小">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,8,0">
                    <icons:Icon Classes="source-icon" Value="{Binding SourceIconValue}"
                                Foreground="{Binding SourceIconBrush}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CaptionTitle}" FontSize="11"
                               Foreground="{Binding TextBrush}" Opacity="0.8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Border Grid.Column="1" Name="HoverToolbar"
                    Background="#D0202833" CornerRadius="12" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="toolbar-btn" Click="OnDecreaseFontSize"
                                AutomationProperties.Name="减小字幕字号" ToolTip.Tip="减小字号（Ctrl+减号）">
                            <icons:Icon Value="fa-solid fa-minus"/>
                        </Button>
                        <Button Classes="toolbar-btn" Click="OnIncreaseFontSize"
                                AutomationProperties.Name="增大字幕字号" ToolTip.Tip="增大字号（Ctrl+加号）">
                            <icons:Icon Value="fa-solid fa-plus"/>
                        </Button>
                        <Button Classes="toolbar-btn" Click="OnResetFontSize"
                                AutomationProperties.Name="恢复自动字幕字号" ToolTip.Tip="恢复自动字号及默认大小（Ctrl+0）">
                            <icons:Icon Value="fa-solid fa-rotate-left"/>
                        </Button>
                        <Button Classes="toolbar-btn" Click="OnToggleFontSizeLock"
                                AutomationProperties.Name="{Binding FontModeToolTip}" ToolTip.Tip="{Binding FontModeToolTip}">
                            <icons:Icon Value="{Binding FontModeIconValue}"/>
                        </Button>
                        <Button Classes="toolbar-btn" Click="OnToggleBackground"
                                AutomationProperties.Name="切换字幕背景与对比度" ToolTip.Tip="切换字幕背景与对比度">
                            <icons:Icon Value="fa-solid fa-circle-half-stroke"/>
                        </Button>
                        <Button Classes="toolbar-btn" Click="OnToggleClickThrough"
                                AutomationProperties.Name="切换字幕点击穿透"
                                ToolTip.Tip="穿透后，请在主界面字幕菜单选择“恢复字幕交互”，或切回此窗口按 Esc 恢复">
                            <icons:Icon Value="fa-solid fa-hand-pointer"/>
                        </Button>
                        <Button Classes="toolbar-btn" Click="OnCloseClick"
                                AutomationProperties.Name="关闭字幕窗口" ToolTip.Tip="关闭字幕窗口">
                            <icons:Icon Value="fa-solid fa-xmark"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 固定两行阅读区：高度决定自动字号，宽度决定每页容量。 -->
            <Grid Grid.Row="1" Margin="14,4,14,8">
                <Border Name="SubtitleHost"
                    Background="Transparent"
                    Padding="0,0,0,2"
                    ClipToBounds="True">
                    <TextBlock Name="SubtitleTextBlock"
                        Text="{Binding FormattedSubtitleText}"
                        FontWeight="Bold"
                        Foreground="{Binding TextBrush}"
                        FontSize="32"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="None"
                        ClipToBounds="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        TextAlignment="Left"
                        RenderOptions.TextRenderingMode="Antialias"
                        Effect="{Binding TextShadowEffect}" />
                </Border>
            </Grid>

            <!-- 争抢角标：仅争抢窗口出现的浮动闪电图标，叠加在左上角，不影响主字幕布局 -->
            <icons:Icon
                Classes="source-icon"
                Value="{Binding SecondaryIconValue}"
                Foreground="{Binding SecondaryIconBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8,-6,0,0"
                FontSize="14"
                Opacity="0.9"
                IsHitTestVisible="False"
                IsVisible="{Binding IsSecondaryVisible}"/>

            <!-- 右下角 resize 把手 -->
            <Border Name="ResizeGrip"
                    Grid.Row="1"
                    Width="22" Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,4,4"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    PointerPressed="OnResizePointerPressed"
                    ToolTip.Tip="拖宽可增加每行文字；拖高可放大自动字号（锁定字号时大小不变）">
                <Path Fill="#CCFFFFFF"
                      Stretch="Uniform"
                      Margin="4"
                      Data="M 0 12 L 12 0 M 4 12 L 12 4 M 8 12 L 12 8"
                      Stroke="#CCFFFFFF"
                      StrokeThickness="1.5"/>
            </Border>
        </Grid>
    </Border>
</Window>