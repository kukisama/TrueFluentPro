<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TrueFluentPro.ViewModels"
        xmlns:models="using:TrueFluentPro.Models"
        xmlns:controls="using:TrueFluentPro.Controls"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:icons="https://github.com/projektanker/icons.avalonia"
        xmlns:views="using:TrueFluentPro.Views"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="860"
        x:Class="TrueFluentPro.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Title="译见 Pro"
        SystemDecorations="BorderOnly"
        Width="1440"
        Height="860"
        MinWidth="1000"
        MinHeight="550">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <controls:LevelToHeightConverter x:Key="LevelToHeight" MaxHeight="16"/>
        <!-- 只用于原稿标题按钮，不替换经典或旧书斋的全局 Button 主题。 -->
        <ControlTheme x:Key="InkStudyCaptionButtonTheme" TargetType="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_CaptionSurface" Background="{TemplateBinding Background}">
                        <Grid>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Background="Transparent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"/>
                            <Border x:Name="PART_CaptionFocus" Margin="4"
                                    BorderThickness="2" CornerRadius="2"
                                    BorderBrush="#79613A" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.shell-caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.shell-caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.shell-caption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubCardBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.shell-caption-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.shell-caption-close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#A92215"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.shell-nav-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="6,0,6,6"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="Button.shell-nav-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Button.shell-nav-action.selected">
            <Setter Property="Background" Value="{DynamicResource ShellNavSelectedBrush}"/>
        </Style>
        <Style Selector="Button.shell-nav-action.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.shell-nav-action.selected icons|Icon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>
        <Style Selector="Button.shell-nav-action.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Button.shell-nav-action:pressed">
            <Setter Property="Background" Value="{DynamicResource SubCardBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.shell-nav-toggle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6,0,6,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.shell-nav-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="ui|InfoBar">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="ui|InfoBar TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxLines" Value="1"/>
        </Style>
        <StyleInclude Source="avares://TrueFluentPro/Styles/SongStudy.axaml"/>
        <!-- 将默认值放在 Style 层级，避免内联 LocalValue 压住 ink-study 覆盖。 -->
        <Style Selector="Border#ShellTitleBar">
            <Setter Property="Background" Value="{DynamicResource NavPanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>
        <Style Selector="Border#ShellTitleBar TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector=":is(Window).ink-study Border#ShellTitleBar">
            <Setter Property="Background" Value="#EEE9DF"/>
            <Setter Property="BorderBrush" Value="#D5C4A5"/>
        </Style>
        <Style Selector=":is(Window).ink-study Border#ShellTitleBar TextBlock">
            <Setter Property="Foreground" Value="#263832"/>
            <Setter Property="FontFamily" Value="SimSun, Songti SC, serif"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption">
            <Setter Property="Theme" Value="{StaticResource InkStudyCaptionButtonTheme}"/>
            <Setter Property="Foreground" Value="#263832"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption:pointerover">
            <Setter Property="Background" Value="#E2D8C5"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#263832"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption:pressed">
            <Setter Property="Background" Value="#D2C4AB"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption:focus-visible /template/ Border#PART_CaptionFocus">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption-close:pointerover">
            <Setter Property="Background" Value="#AD4436"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption-close:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector=":is(Window).ink-study Button.shell-caption-close:pressed">
            <Setter Property="Background" Value="#8B3028"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*"
          Background="{DynamicResource PageBackgroundBrush}">
        <!-- 与正文使用同一 DIP 布局及绘制缩放，不使用系统标题栏的物理像素高度。 -->
        <Border Name="ShellTitleBar"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <Border Name="ShellTitleDragArea"
                        Height="40"
                        Background="Transparent"
                        PointerPressed="ShellTitleDragArea_PointerPressed">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Margin="14,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="ShellMinimizeButton"
                            Classes="shell-caption"
                            Click="ShellMinimizeButton_Click"
                            ToolTip.Tip="最小化"
                            AutomationProperties.Name="最小化">
                        <icons:Icon Value="fa-solid fa-minus" FontSize="12"/>
                    </Button>
                    <Button Name="ShellMaximizeButton"
                            Classes="shell-caption"
                            Click="ShellMaximizeButton_Click"
                            ToolTip.Tip="最大化"
                            AutomationProperties.Name="最大化">
                        <icons:Icon Name="ShellMaximizeIcon" Value="fa-regular fa-window-maximize" FontSize="12"/>
                    </Button>
                    <Button Name="ShellCloseButton"
                            Classes="shell-caption shell-caption-close"
                            Click="ShellCloseButton_Click"
                            ToolTip.Tip="关闭"
                            AutomationProperties.Name="关闭">
                        <icons:Icon Value="fa-solid fa-xmark" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Name="LegacyWorkspace" Grid.Row="1" ColumnDefinitions="Auto,*">
        <Border Name="ShellNavRail"
                Grid.Column="0"
                Width="52"
                Background="{DynamicResource NavPanelBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
                 <Panel>
                 <Image Name="StudyNavBamboo" IsVisible="False"
                     Source="avares://TrueFluentPro/Assets/Appearance/SongStudy/bamboo-left.png"
                     Height="160" Stretch="Uniform" Opacity="0.16"
                     VerticalAlignment="Top" HorizontalAlignment="Left"
                     IsHitTestVisible="False"/>
                 <Image Name="StudyTassel" IsVisible="False"
                     Source="avares://TrueFluentPro/Assets/Appearance/SongStudy/tassel.png"
                     Width="24" Height="160" Stretch="Uniform" Opacity="0.55"
                     Margin="0,0,0,112" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                     IsHitTestVisible="False"/>
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="0,8,0,0">
                    <StackPanel Name="StudyBrand" IsVisible="False" Margin="18,12,10,20" Spacing="5">
                        <TextBlock Text="译见 Pro" FontFamily="SimSun, Songti SC, serif" FontSize="25"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="听世界的声音，续更多人所见" FontSize="10"
                                   Foreground="{DynamicResource TextSubtleBrush}"/>
                        <Border Height="1" Margin="0,8,0,0" Background="#C4AE7D"/>
                    </StackPanel>
                    <Button Name="ShellNavToggleButton" Classes="shell-nav-toggle"
                            Click="ToggleShellNavButton_Click"
                            ToolTip.Tip="展开/收起导航"
                            AutomationProperties.Name="展开或收起导航">
                        <icons:Icon Value="fa-solid fa-bars"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Name="LiveNavButton"
                            Classes="shell-nav-action selected"
                            Click="LiveNavButton_Click"
                            ToolTip.Tip="实时翻译 (Ctrl+1)"
                            AutomationProperties.Name="实时翻译 (Ctrl+1)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-solid fa-microphone-lines"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="实时翻译"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Name="ReviewNavButton"
                            Classes="shell-nav-action"
                            Click="ReviewNavButton_Click"
                            IsVisible="False"
                            ToolTip.Tip="复盘洞察 (Ctrl+2)"
                            AutomationProperties.Name="复盘洞察 (Ctrl+2)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-solid fa-bars-progress"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="复盘洞察"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Name="BatchNavButton"
                            Classes="shell-nav-action"
                            Click="BatchNavButton_Click"
                            IsVisible="False"
                            ToolTip.Tip="批量字幕 (Ctrl+3)"
                            AutomationProperties.Name="批量字幕 (Ctrl+3)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-solid fa-layer-group"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="批量字幕"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Name="MediaNavButton"
                            Classes="shell-nav-action"
                            Click="MediaNavButton_Click"
                            ToolTip.Tip="创作工坊 (Ctrl+4)"
                            AutomationProperties.Name="创作工坊 (Ctrl+4)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-regular fa-images"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="创作工坊"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Name="MediaV2NavButton"
                            Classes="shell-nav-action"
                            Click="MediaV2NavButton_Click"
                            ToolTip.Tip="媒体中心 (Ctrl+6)"
                            AutomationProperties.Name="媒体中心 (Ctrl+6)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-solid fa-photo-film"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="媒体中心"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Name="AudioLabNavButton"
                            Classes="shell-nav-action"
                            Click="AudioLabNavButton_Click"
                            ToolTip.Tip="听析中心 (Ctrl+7)"
                            AutomationProperties.Name="听析中心 (Ctrl+7)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-solid fa-headphones"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="听析中心"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Name="TaskMonitorNavButton"
                            Classes="shell-nav-action"
                            Click="TaskMonitorNavButton_Click"
                            ToolTip.Tip="任务监控 (Ctrl+8)"
                            AutomationProperties.Name="任务监控 (Ctrl+8)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-solid fa-list-check"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="任务监控"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <Button Name="ThemeNavButton"
                            Classes="shell-nav-action"
                            Click="ThemeNavButton_Click"
                            ToolTip.Tip="选择经典主题或宋人书斋"
                            AutomationProperties.Name="切换主题模式">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Name="ShellThemeIcon" Grid.Column="0"
                                        Value="fa-solid fa-circle-half-stroke"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="主题"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Name="SettingsNavButton"
                            Classes="shell-nav-action"
                            Click="SettingsNavButton_Click"
                            ToolTip.Tip="打开设置 (Ctrl+5 / Ctrl+,)"
                            AutomationProperties.Name="打开设置 (Ctrl+5 / Ctrl+,)">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <icons:Icon Grid.Column="0"
                                        Value="fa-solid fa-gear"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="设置"
                                       VerticalAlignment="Center"
                                       Classes="shell-nav-label" IsVisible="False"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
            </Panel>
        </Border>

        <Panel Name="PageSurface" Grid.Column="1">
            <controls:SongStudyBookFrame Name="StudyBook" IsVisible="False" Margin="6,6,12,10"/>
            <Image Name="StudyBamboo" IsVisible="False"
                   Source="avares://TrueFluentPro/Assets/Appearance/SongStudy/bamboo-right.png"
                   Width="150" Height="100" Stretch="Uniform" Opacity="0.25"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0"
                   IsHitTestVisible="False"/>
            <Panel Name="PageHost">
                <Border Name="PagePlaceholder"
                        Margin="16"
                        Padding="18,14"
                        CornerRadius="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel Spacing="8"
                                VerticalAlignment="Top">
                        <TextBlock Text="正在打开首页..."
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="壳层已加载，首页内容正在继续初始化。"
                                   Foreground="{DynamicResource TextSubtleBrush}"/>
                    </StackPanel>
                </Border>
            </Panel>
            <ui:InfoBar IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay}"
                        Message="{Binding InfoBarMessage}"
                        Severity="{Binding InfoBarSeverity}"
                        IsClosable="True"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        MaxWidth="760"
                        Margin="0,0,20,16"/>
        </Panel>
        </Grid>
        <!-- 独立原稿翻译页与长卷各页的全页宿主；经典树仍留在原宿主。 -->
        <Panel Name="InkStudyHost" Grid.Row="1" IsVisible="False"/>
        <Panel Name="SongScrollHost" Grid.Row="0" Grid.RowSpan="2" IsVisible="False"/>
    </Grid>
</Window>
