<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 只由 SongScrollShell 的局部 Styles 加载，不改变旧主题或业务 VM。 -->
  <StyleInclude Source="avares://TrueFluentPro/Styles/SongScrollControls.axaml"/>
  <Styles.Resources>
    <SolidColorBrush x:Key="ScrollInk" Color="#27332F"/>
    <SolidColorBrush x:Key="ScrollMuted" Color="#6B7165"/>
    <SolidColorBrush x:Key="ScrollAccent" Color="#4D7979"/>
    <ImageBrush x:Key="ScrollPaper" Source="avares://TrueFluentPro/Assets/Appearance/SongScroll/page-paper.png"
                TileMode="Tile" DestinationRect="0,0,180,180"/>
  </Styles.Resources>

  <!-- 正文继承 Shell 的楷体/28px/墨色，不覆盖按钮模板继承的朱印白字。 -->
  <Style Selector="Button"><Setter Property="FontSize" Value="26"/><Setter Property="MinHeight" Value="50"/></Style>
  <Style Selector="Button.text"><Setter Property="MinHeight" Value="50"/></Style>
  <Style Selector="TextBox"><Setter Property="FontSize" Value="28"/><Setter Property="MinHeight" Value="54"/><Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="{StaticResource ScrollInk}"/></Style>
  <Style Selector="ComboBox"><Setter Property="FontSize" Value="26"/><Setter Property="MinHeight" Value="50"/><Setter Property="Padding" Value="14,8"/></Style>
  <Style Selector="CheckBox"><Setter Property="FontFamily" Value="{StaticResource ScrollKai}"/><Setter Property="FontSize" Value="26"/><Setter Property="MinHeight" Value="50"/><Setter Property="Foreground" Value="{StaticResource ScrollInk}"/></Style>
  <Style Selector="RadioButton"><Setter Property="FontFamily" Value="{StaticResource ScrollKai}"/><Setter Property="FontSize" Value="26"/><Setter Property="MinHeight" Value="50"/></Style>

  <Style Selector="Border.scroll-paper"><Setter Property="Background" Value="#50FFFCF5"/><Setter Property="BorderBrush" Value="#80CBBDA4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
  <Style Selector="TextBox.scroll-input"><Setter Property="Background" Value="#99FFFCF5"/><Setter Property="BorderBrush" Value="#B4B5AE9D"/><Setter Property="CornerRadius" Value="9"/></Style>
  <Style Selector="ComboBox.scroll-input"><Setter Property="Background" Value="#99FFFCF5"/><Setter Property="BorderBrush" Value="#B4B5AE9D"/></Style>
  <Style Selector="Button.scroll-primary"><Setter Property="Background" Value="{StaticResource ScrollAccent}"/><Setter Property="BorderBrush" Value="#3E6868"/><Setter Property="Foreground" Value="#FFF8E7"/><Setter Property="MinHeight" Value="54"/><Setter Property="Padding" Value="24,10"/></Style>
  <Style Selector="Button.scroll-primary:pointerover"><Setter Property="Background" Value="#3D6666"/></Style>
  <Style Selector="Button.scroll-primary:pressed"><Setter Property="Background" Value="#315B5B"/></Style>
  <Style Selector="TextBlock.scroll-section-title"><Setter Property="FontSize" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#34594F"/><Setter Property="Margin" Value="0,8,0,14"/></Style>
  <Style Selector="TextBlock.scroll-quiet"><Setter Property="FontSize" Value="26"/><Setter Property="Foreground" Value="{StaticResource ScrollMuted}"/></Style>
  <Style Selector="SelectableTextBlock.scroll-quiet"><Setter Property="FontSize" Value="26"/><Setter Property="Foreground" Value="{StaticResource ScrollMuted}"/></Style>
  <Style Selector="Button.scroll-quiet"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#50675E"/><Setter Property="MinHeight" Value="50"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style Selector="Button.scroll-quiet:pointerover"><Setter Property="Background" Value="#50E4DDD0"/><Setter Property="Foreground" Value="{StaticResource ScrollAccent}"/></Style>
  <Style Selector="ListBox.scroll-list"><Setter Property="FontFamily" Value="{StaticResource ScrollKai}"/><Setter Property="FontSize" Value="28"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource ScrollInk}"/></Style>
  <Style Selector="ListBox.scroll-list ListBoxItem"><Setter Property="MinHeight" Value="60"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style Selector="ListBox.scroll-list ListBoxItem:selected"><Setter Property="Background" Value="#88E0E7DC"/><Setter Property="Foreground" Value="#34594F"/></Style>
  <Style Selector="ListBox.scroll-list ListBoxItem:pointerover"><Setter Property="Background" Value="#60EAE3D4"/></Style>
  <Style Selector="Button#ShellSettings.selected"><Setter Property="BorderBrush" Value="{StaticResource ScrollAccent}"/><Setter Property="BorderThickness" Value="0,0,0,2"/></Style>

  <!-- 焦点仅描画小把手，不给整条透明命中区画原生焦点框。 -->
  <Style Selector="Border#ShellSpineGrip"><Setter Property="Opacity" Value="0.5"/></Style>
  <Style Selector="Border#ShellSpineHandle:pointerover Border#ShellSpineGrip"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Border#ShellSpineHandle:focus-visible Border#ShellSpineGrip"><Setter Property="Opacity" Value="1"/><Setter Property="BorderBrush" Value="#476857"/><Setter Property="BorderThickness" Value="3"/></Style>
  <Style Selector="Border#ShellSpineHandle.dragging Border#ShellSpineGrip"><Setter Property="Opacity" Value="1"/></Style>
</Styles>