<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 仅在书斋模式合并到窗口资源；不包含类型主题，不触发全树样式重应用。 -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF5F0E6"/>
    <SolidColorBrush x:Key="NavPanelBackgroundBrush" Color="#FFF2EBDD"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFCF5"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFDFD2B9"/>
    <SolidColorBrush x:Key="SubCardBackgroundBrush" Color="#FFFAF5EB"/>
    <SolidColorBrush x:Key="SubCardBorderBrush" Color="#FFE4D9C6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFAF6EE"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF3EDDF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFEDE2D0"/>
    <SolidColorBrush x:Key="ShellNavSelectedBrush" Color="#FFF6E7DC"/>
    <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#FFF5F0E6"/>
    <SolidColorBrush x:Key="SettingsNavBackgroundBrush" Color="#FFF2EBDD"/>
    <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#FFFFFCF5"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#FFDFD2B9"/>
    <SolidColorBrush x:Key="SettingsCardInnerBackgroundBrush" Color="#FFFAF5EB"/>
    <SolidColorBrush x:Key="UserMessageBrush" Color="#FFF0E8DA"/>
    <SolidColorBrush x:Key="AiMessageBrush" Color="#FFFAF6EE"/>
    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#FFEFE9DD"/>
    <SolidColorBrush x:Key="CodeInlineForegroundBrush" Color="#FF9D3A30"/>
    <SolidColorBrush x:Key="TableBorderBrush" Color="#FFDFD2B9"/>
    <SolidColorBrush x:Key="MediaItemBrush" Color="#FFEFE9DD"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFAF6EE"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFE6DDCC"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#FFD8CBB4"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFB5A385"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#FFE0D4BE"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFD9CCB4"/>
    <SolidColorBrush x:Key="ThumbnailBorderBrush" Color="#FFCBBB9D"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFAD4436"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF8B3028"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FFA33D31"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF302D27"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF696252"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#FF7C7363"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#FF8D8474"/>
    <SolidColorBrush x:Key="TimestampBrush" Color="#FF807766"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="#FF575145"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF497351"/>
    <SolidColorBrush x:Key="IndicatorGreenBrush" Color="#FF628765"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF99611E"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF3D6447"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFAD302D"/>
    <SolidColorBrush x:Key="PendingPlaceholderBackgroundBrush" Color="#FFFAF5EB"/>
    <SolidColorBrush x:Key="PendingPlaceholderBorderBrush" Color="#FFE0D2B8"/>
    <SolidColorBrush x:Key="PendingPlaceholderIconBrush" Color="#FF958260"/>
    <SolidColorBrush x:Key="PendingPlaceholderTextBrush" Color="#FF6C614D"/>
</ResourceDictionary>