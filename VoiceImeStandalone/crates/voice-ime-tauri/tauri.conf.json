{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "译见pro · 输入法工具",
  "version": "1.0.0",
  "identifier": "com.truefluent.voiceime.standalone",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "译见pro · 输入法工具",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
