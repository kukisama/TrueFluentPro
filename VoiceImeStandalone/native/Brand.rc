#include <winver.h>

#ifndef VOICE_IME_VERSION_CSV
#define VOICE_IME_VERSION_CSV 1,0,0,0
#endif
#ifndef VOICE_IME_VERSION_STR
#define VOICE_IME_VERSION_STR "1.0.0"
#endif

#ifdef VOICE_IME_REGISTER_HELPER
#define VOICE_IME_FILE_TYPE VFT_APP
#define VOICE_IME_FILENAME "VoiceImeRegister.exe"
#else
#define VOICE_IME_FILE_TYPE VFT_DLL
#define VOICE_IME_FILENAME "VoiceImeStandalone.dll"
101 ICON "ImeBrand.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION VOICE_IME_VERSION_CSV
PRODUCTVERSION VOICE_IME_VERSION_CSV
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VOICE_IME_FILE_TYPE
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "TrueFluent"
            VALUE "FileDescription", "译见pro语音输入法（独立版）"
            VALUE "FileVersion", VOICE_IME_VERSION_STR
            VALUE "InternalName", VOICE_IME_FILENAME
            VALUE "OriginalFilename", VOICE_IME_FILENAME
            VALUE "ProductName", "译见pro语音输入法"
            VALUE "ProductVersion", VOICE_IME_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
